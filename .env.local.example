# Senha única de acesso à área administrativa (/admin)
ADMIN_PASSWORD=troque-esta-senha

# Supabase — Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Google (Drive das galerias + Agenda do backlog) — OAuth Client ID em
# console.cloud.google.com > APIs & Services > Credentials. Tipo "Web
# application". Ative a "Google Drive API" no projeto. Redirect URI precisa
# ser exatamente igual ao registrado no Client ID (uma entrada por ambiente).
# Ative também a "Google Calendar API" pra sincronizar o calendário do backlog.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/drive/oauth/callback

# Fuso usado ao criar os eventos do backlog no Google Agenda. Opcional —
# o padrão é America/Sao_Paulo.
# BACKLOG_TIME_ZONE=America/Sao_Paulo

# CallMeBot — avisa no WhatsApp quando um briefing chega em /briefing.
# Setup: salve o número do bot nos contatos, mande "I allow callmebot to send
# me messages" pra ele e ele responde com a apikey. Telefone com código do
# país e sem símbolos. Sem essas duas variáveis o briefing ainda é salvo,
# só não avisa.
CALLMEBOT_PHONE=5511999999999
CALLMEBOT_APIKEY=

# Pasta do Drive onde as referências enviadas em /admin/referencias são
# gravadas. É o trecho depois de /folders/ na URL da pasta.
DRIVE_REFERENCES_FOLDER_ID=

# Web Push (notificações no celular). Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Preencher orçamento com IA (aba Orçamento). OPENAI_MODEL é opcional (padrão gpt-6.1-terra).
OPENAI_API_KEY=

# Instagram Login (agendamento de posts de clientes). App Business em
# developers.facebook.com. O redirect tem que bater com o cadastrado no app:
# https://<dominio>/api/instagram/oauth/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=

# Tatu Agent no Telegram. Bot criado no @BotFather (token e @ do bot).
# TELEGRAM_WEBHOOK_SECRET: texto aleatório só com letras, números, _ e -
# (até 256); o Telegram manda de volta em todo update e o webhook confere.
# TELEGRAM_HUB_CHAT_ID: id do supergrupo TATU | HUB (ex.: -1001234567890);
# vazio = o bot ignora grupos. O /configurar no grupo mostra o id.
# Depois do deploy: node --env-file=.env.local scripts/telegram-webhook.mjs https://<dominio>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_HUB_CHAT_ID=
