# Connection string do Postgres do Supabase.
# Painel > Project Settings > Database > Connection string > URI
#
# É credencial DIFERENTE da service role key do .env.local: esta tem a senha do
# banco. Copie este arquivo pra .env.backup (que o git ignora) e preencha.
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres

# Opcional. Padrão: ~/Backups/guia-de-captacao
# BACKUP_DIR=/caminho/onde/guardar
