# Credenciais do banco pro scripts/backup-db.sh.
# Painel do Supabase > Project Settings > Database.
#
# ATENÇÃO: é credencial diferente da service role key do .env.local — esta é a
# senha do banco. Copie este arquivo pra .env.backup (que o git ignora).

# --- Jeito recomendado: campos separados ---
# A senha vai crua, sem codificar nada. Use este se ela tiver @ & ; $ ou espaço,
# que numa URI fazem o libpq ler host e porta errados.
SUPABASE_DB_HOST=db.SEUPROJETO.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=cole-a-senha-aqui-sem-aspas-e-sem-codificar

# --- Alternativa: URI pronta ---
# Só funciona se a senha não tiver caractere especial. Deixe comentado se
# estiver usando os campos acima.
# SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres

# Opcional. Padrão: ~/Backups/guia-de-captacao
# BACKUP_DIR=/caminho/onde/guardar
